  <!-- #################################################################### -->
  <!-- "FurryCavernsBrown" -->
  <!-- #################################################################### -->
  <THParallaxSetData mName="FurryCavernsBrown">

    <THParallaxData>
      <mTextureName>Art/Backgrounds/TaigaBreach/FurryCavernsBrown</mTextureName>
      <mTechnique>OverlayBitmapTechnique</mTechnique>
      <mVelocity>
        <X>0.0</X>
        <Y>0.0</Y>
      </mVelocity>
      <mParallax>
        <X>0.5</X>
        <Y>0.5</Y>
      </mParallax>
      <mOffset>
        <X>0</X>
        <Y>0</Y>
      </mOffset>
      <mGradientData>
        <mStartColor>
          <R>153</R>
          <G>136</G>
          <B>160</B>
          <A>0</A>
        </mStartColor>
        <mEndColor>
          <R>153</R>
          <G>136</G>
          <B>160</B>
          <A>255</A>
        </mEndColor>
        <mStartY>20</mStartY>
        <mEndY>120</mEndY>
        <mParallax>
          <X>0.0</X>
          <Y>0.0</Y>
        </mParallax>
      </mGradientData>
      <mAnchor>BottomLeft</mAnchor>
    </THParallaxData>

    <!-- Breach background colors-->
    <mBreachEffectParams>
      <mGradientStartColor>
        <R>0</R>
        <G>0</G>
        <B>0</B>
        <A>255</A>
      </mGradientStartColor>
      <mGradientEndColor>
        <R>67</R>
        <G>181</G>
        <B>170</B>
        <A>255</A>
      </mGradientEndColor>
      <mGradientStartY>40</mGradientStartY>
      <mGradientEndY>120</mGradientEndY>

      <VignetteColor>
        <R>97</R>
        <G>201</G>
        <B>201</B>
        <A>128</A>
      </VignetteColor>
      <mVignetteStart>0.4</mVignetteStart>
      <mVignetteEnd>1.0</mVignetteEnd>
      <mVignetteRadius>
        <X>60</X>
        <Y>40</Y>
      </mVignetteRadius>

      <mHueRange>0.1</mHueRange>
      <mBeatsPerHueCycle>8</mBeatsPerHueCycle>

    </mBreachEffectParams>
  </THParallaxSetData>


