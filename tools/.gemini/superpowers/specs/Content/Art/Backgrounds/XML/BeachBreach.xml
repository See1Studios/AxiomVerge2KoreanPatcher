  <!-- #################################################################### -->
  <!-- "BeachBreach" -->
  <!-- #################################################################### -->
  <THParallaxSetData mName="BeachBreach">


    <THParallaxData>
      <mTextureName>Art/Backgrounds/BeachBreach/Beach</mTextureName>
      <mTechnique>OverlayBitmapTechnique</mTechnique>
      <mVelocity>
        <X>0.0</X>
        <Y>0.0</Y>
      </mVelocity>
      <mParallax>
        <X>0.5</X>
        <Y>0.5</Y>
      </mParallax>
      <mOffset>
        <X>0</X>
        <Y>0</Y>
      </mOffset>
      <mGradientData>
        <mStartColor>
          <R>82</R>
          <G>199</G>
          <B>243</B>
          <A>0</A>
        </mStartColor>
        <mEndColor>
          <R>82</R>
          <G>199</G>
          <B>243</B>
          <A>255</A>
        </mEndColor>
        <mStartY>60</mStartY>
        <mEndY>120</mEndY>
        <mParallax>
          <X>0.0</X>
          <Y>0.0</Y>
        </mParallax>
      </mGradientData>
      <mWrapX>true</mWrapX>
      <mAnchor>BottomLeft</mAnchor>
    </THParallaxData>

    <!-- Breach background colors-->
    <mBreachEffectParams>
      <mGradientStartColor>
        <R>0</R>
        <G>0</G>
        <B>59</B>
        <A>255</A>
      </mGradientStartColor>
      <mGradientEndColor>
        <R>0</R>
        <G>174</G>
        <B>222</B>
        <A>255</A>
      </mGradientEndColor>
      <mGradientStartY>60</mGradientStartY>
      <mGradientEndY>120</mGradientEndY>
      <mReflected>false</mReflected>

      <VignetteColor>
        <R>65</R>
        <G>65</G>
        <B>192</B>
        <A>128</A>
      </VignetteColor>
      <mVignetteStart>0.4</mVignetteStart>
      <mVignetteEnd>1.0</mVignetteEnd>
      <mVignetteRadius>
        <X>60</X>
        <Y>40</Y>
      </mVignetteRadius>

      <mScanlineBeatsPerScreen>6</mScanlineBeatsPerScreen>
      <mScanGlowBrightness>0.05</mScanGlowBrightness>
      <mScanGlowRadius>0.25</mScanGlowRadius>
      <mParticleBrightness>0.25</mParticleBrightness>

      <mHueRange>0.05</mHueRange>
      <mBeatsPerHueCycle>8</mBeatsPerHueCycle>

      <mBloomContrast>1.1</mBloomContrast>
      <mBloomSaturation>1.6</mBloomSaturation>
      <mBloomOffset>0.0</mBloomOffset>
      <mBloomTint>
        <X>1</X>
        <Y>1</Y>
        <Z>1</Z>
        <W>0.5</W>
      </mBloomTint>
      <!-- Pixels at 720p -->
      <mBloomWidth>3.0</mBloomWidth>


    </mBreachEffectParams>
  </THParallaxSetData>

