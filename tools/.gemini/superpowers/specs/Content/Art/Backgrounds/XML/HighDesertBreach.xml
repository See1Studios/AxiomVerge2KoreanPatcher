        <B>151</B>
        <A>255</A>
      </mGradientEndColor>
      <mGradientStartY>0</mGradientStartY>
      <mGradientEndY>120</mGradientEndY>

      <VignetteColor>
        <R>146</R>
        <G>88</G>
        <B>109</B>
        <A>128</A>
      </VignetteColor>
      <mVignetteStart>0.4</mVignetteStart>
      <mVignetteEnd>1.0</mVignetteEnd>
      <mVignetteRadius>
        <X>60</X>
        <Y>40</Y>
      </mVignetteRadius>

      <mHueRange>0.1</mHueRange>
      <mBeatsPerHueCycle>12</mBeatsPerHueCycle>

    </mBreachEffectParams>
  </THParallaxSetData>


