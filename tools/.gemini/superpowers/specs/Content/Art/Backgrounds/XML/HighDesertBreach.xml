          <B>112</B>
          <A>255</A>
        </mEndColor>
        <mStartY>0</mStartY>
        <mEndY>240</mEndY>
        <mParallax>
          <X>0.0</X>
          <Y>0.0</Y>
        </mParallax>
      </mGradientData>
    </THParallaxData>

    <!-- Breach background colors-->
    <mBreachEffectParams>
      <mGradientStartColor>
        <R>178</R>
        <G>92</G>
        <B>86</B>
        <A>255</A>
      </mGradientStartColor>
      <mGradientEndColor>
        <R>255</R>
