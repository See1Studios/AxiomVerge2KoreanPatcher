  <THParallaxSetData mName="FortressBreach">

    <!-- Buildings -->
    <THParallaxData>
      <mTextureName>Art/Backgrounds/HighDesertBreach/FortressBreach</mTextureName>
      <mTechnique>OverlayBitmapTechnique</mTechnique>
      <mVelocity>
        <X>0.0</X>
        <Y>0.0</Y>
      </mVelocity>
      <mParallax>
        <X>0.5</X>
        <Y>0.5</Y>
