  <!-- #################################################################### -->
  <!-- Blue Cavern walls -->
  <!-- #################################################################### -->
  <THParallaxSetData mName="WorldStreamBlueRock">

    <THParallaxData>
      <mType>GRADIENT</mType>
      <mGradientData>
        <mStartColor>
          <R>0</R>
          <G>0</G>
          <B>0</B>
          <A>0</A>
        </mStartColor>
        <mEndColor>
          <R>0</R>
          <G>0</G>
          <B>0</B>
          <A>255</A>
        </mEndColor>
        <mStartY>0</mStartY>
        <mEndY>720</mEndY>
        <mParallax>
          <X>0.75</X>
          <Y>0.75</Y>
        </mParallax>
      </mGradientData>
    </THParallaxData>

    <THParallaxData>
      <mTextureName>Art/Backgrounds/WorldStream/BlueRock</mTextureName>
      <mParallax>
        <X>0.5</X>
        <Y>0.5</Y>
      </mParallax>
    </THParallaxData>
  </THParallaxSetData>

