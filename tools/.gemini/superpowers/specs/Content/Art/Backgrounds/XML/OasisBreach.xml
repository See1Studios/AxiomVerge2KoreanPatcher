  <!-- #################################################################### -->
  <!-- "GreenHills" -->
  <!-- #################################################################### -->
  <THParallaxSetData mName="OasisGreenHillsBreach">

    <THParallaxData>
      <mTextureName>Art/Backgrounds/OasisBreach/GreenHills</mTextureName>
      <mTechnique>OverlayBitmapTechnique</mTechnique>
      <mVelocity>
        <X>0.0</X>
        <Y>0.0</Y>
      </mVelocity>
      <mParallax>
        <X>0.5</X>
        <Y>0.5</Y>
      </mParallax>
      <mOffset>
        <X>0</X>
        <Y>0</Y>
      </mOffset>
      <mGradientData>
        <mStartColor>
          <R>254</R>
          <G>250</G>
          <B>37</B>
          <A>0</A>
        </mStartColor>
        <mEndColor>
          <R>254</R>
          <G>250</G>
          <B>37</B>
          <A>255</A>
        </mEndColor>
        <mStartY>80</mStartY>
        <mEndY>200</mEndY>
        <mParallax>
          <X>0.0</X>
          <Y>0.0</Y>
        </mParallax>
      </mGradientData>
      <mAnchor>BottomLeft</mAnchor>
    </THParallaxData>

    <!-- Breach background colors-->
    <mBreachEffectParams>     
      <mGradientStartColor>
        <R>223</R>
        <G>220</G>
        <B>104</B>
        <A>255</A>
      </mGradientStartColor>
      <mGradientEndColor>
        <R>134</R>
        <G>174</G>
        <B>17</B>
        <A>255</A>
      </mGradientEndColor>
      <mGradientStartY>120</mGradientStartY>
      <mGradientEndY>240</mGradientEndY>
      <mReflected>true</mReflected>

      <VignetteColor>
        <R>79</R>
        <G>128</G>
        <B>77</B>
        <A>128</A>
      </VignetteColor>
      <mVignetteStart>0.4</mVignetteStart>
      <mVignetteEnd>1.0</mVignetteEnd>
      <mVignetteRadius>
        <X>60</X>
        <Y>40</Y>
      </mVignetteRadius>

      <mHueRange>0.1</mHueRange>
      <mBeatsPerHueCycle>8</mBeatsPerHueCycle>

    </mBreachEffectParams>
  </THParallaxSetData>
  
  
