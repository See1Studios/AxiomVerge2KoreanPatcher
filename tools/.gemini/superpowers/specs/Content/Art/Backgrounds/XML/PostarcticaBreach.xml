<?xml version="1.0" encoding="utf-8"?>
<THParallaxXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- #################################################################### -->
  <!-- "PostarcticCyanVignette" -->
  <!-- #################################################################### -->
  <THParallaxSetData mName="PostarcticCyanVignette">

    <!-- Snow particles -->
    <THParallaxData>
      <mType>PARTICLE</mType>
      <mRenderLayer>BackParallax</mRenderLayer>
      <mVelocity>
        <X>0.0</X>
        <Y>0.0</Y>
      </mVelocity>
      <mParallax>
        <X>0.5</X>
        <Y>0.5</Y>
      </mParallax>
      <mWrap>true</mWrap>
      <mParticleData>
        <mSpawnerName>BreachSnow</mSpawnerName>
        <mBoundsType>CAMERA_BOUNDS</mBoundsType>
      </mParticleData>
    </THParallaxData>

    <!-- A vignette texture that follows the camera-->
    <THParallaxData>
      <mTextureName>Art/Backgrounds/PostarcticaBreach/CyanVignette</mTextureName>
      <mParallax>
        <X>0</X>
        <Y>0</Y>
      </mParallax>
      <mColorMultiply>
        <R>255</R>
        <G>255</G>
        <B>255</B>
        <A>255</A>
      </mColorMultiply>
    </THParallaxData>

    <!-- Breach background colors-->
    <mBreachEffectParams>
      <VignetteColor>
        <R>154</R>
        <G>172</G>
        <B>220</B>
        <A>207</A>
      </VignetteColor>
      <mVignetteStart>0.4</mVignetteStart>
      <mVignetteEnd>1.0</mVignetteEnd>
      <mVignetteRadius>
        <X>60</X>
        <Y>40</Y>
      </mVignetteRadius>

      <mHueRange>0.05</mHueRange>
      <mBeatsPerHueCycle>8</mBeatsPerHueCycle>

    </mBreachEffectParams>
  </THParallaxSetData>

