  <!-- #################################################################### -->
  <!-- "PinkGradient" -->
  <!-- #################################################################### -->
  <THParallaxSetData mName="CavernsPinkGradientBreach">
    <!-- Breach background colors-->
    <mBreachEffectParams>
      <mGradientStartColor>
        <R>40</R>
        <G>17</G>
        <B>42</B>
        <A>255</A>
      </mGradientStartColor>
      <mGradientEndColor>
        <R>190</R>
        <G>66</G>
        <B>141</B>
        <A>255</A>
      </mGradientEndColor>
      <mGradientStartY>180</mGradientStartY>
      <mGradientEndY>360</mGradientEndY>
      <mReflected>true</mReflected>

      <VignetteColor>
        <R>78</R>
        <G>40</G>
        <B>137</B>
        <A>167</A>
      </VignetteColor>
      <mVignetteStart>0.4</mVignetteStart>
      <mVignetteEnd>1.0</mVignetteEnd>
      <mVignetteRadius>
        <X>60</X>
        <Y>40</Y>
      </mVignetteRadius>

      <mHueRange>0.1</mHueRange>
      <mBeatsPerHueCycle>8</mBeatsPerHueCycle>

    </mBreachEffectParams>
  </THParallaxSetData>


