  <!-- #################################################################### -->
  <!-- "Blocks" -->
  <!-- #################################################################### -->
  <THParallaxSetData mName="CavernsBlocksBreach">

    <!-- Cavern wall-->
    <THParallaxData>
      <mTextureName>Art/Backgrounds/CavernsBreach/Blocks</mTextureName>
      <mTechnique>OverlayBitmapTechnique</mTechnique>
      <mVelocity>
        <X>0.0</X>
        <Y>0.0</Y>
      </mVelocity>
      <mParallax>
        <X>0.5</X>
        <Y>0.5</Y>
      </mParallax>
      <mOffset>
        <X>0</X>
        <Y>0</Y>
      </mOffset>
      <mGradientData>
        <mStartColor>
          <R>180</R>
          <G>156</G>
          <B>213</B>
          <A>0</A>
        </mStartColor>
        <mEndColor>
          <R>180</R>
          <G>156</G>
          <B>213</B>
          <A>255</A>
        </mEndColor>
        <mStartY>0</mStartY>
        <mEndY>240</mEndY>
        <mParallax>
          <X>0.0</X>
          <Y>0.0</Y>
        </mParallax>
      </mGradientData>
      <mAnchor>BottomLeft</mAnchor>
    </THParallaxData>

    <!-- Breach background colors-->
