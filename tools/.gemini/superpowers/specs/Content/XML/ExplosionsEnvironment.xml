  <THSpriteExplosion mName="DistortionTiles">
    <mAnimationName>DistortionTile8x8</mAnimationName>
    <mMaxCount>10</mMaxCount>
    <mCacheDuration>FULLGAME</mCacheDuration>
    <!-- Needs to be full game since the THGameplayState references them directly. -->
    <mFadeInDuration>0.5</mFadeInDuration>
    <mFadeOutDuration>0.5</mFadeOutDuration>
    <mStartScale>
      <X>1.0</X>
      <Y>1.0</Y>
    </mStartScale>
    <mEndScale>
      <X>1.0</X>
      <Y>1.0</Y>
    </mEndScale>
    <mDistortionScale>1.0</mDistortionScale>
    <mTimeStretch>2</mTimeStretch>
    <mRenderLayer>Distortion</mRenderLayer>
  </THSpriteExplosion>

  <!-- Explosion played when a tile becomes fully glitched. -->
  <THSpriteExplosion mName="GlitchTileExplosion">
    <mAnimationName>SquareExplosion48x48</mAnimationName>
    <mMaxCount>20</mMaxCount>
    <mCacheDuration>FULLGAME</mCacheDuration>
    <mColor>
      <X>0.9</X>
      <Y>0.75</Y>
      <Z>1.0</Z>
      <W>1.0</W>
    </mColor>
    <mStartScale>
