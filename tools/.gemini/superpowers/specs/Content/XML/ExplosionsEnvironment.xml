      <Y>0.25</Y>
    </mStartScale>
    <mEndScale>
      <X>1.0</X>
      <Y>1.0</Y>
    </mEndScale>
    <mTimeStretch>1.5</mTimeStretch>
  </THSpriteExplosion>

