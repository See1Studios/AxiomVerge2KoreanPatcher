  <THGlitchVisualData mName="NPCFlickerGlitch">
    <mTechnique>GlitchTechnique</mTechnique>
    <mFlickerData>
      <mFlickerAnimation>FlickerTopDown8x8</mFlickerAnimation>
      <mMinRestLength> 1</mMinRestLength>
      <mMaxMaxRestLength>2</mMaxMaxRestLength>
      <mMinFlickerLength>5</mMinFlickerLength>
      <mMaxFlickerLength>120</mMaxFlickerLength>
      <mChanceToIncrease>0.50</mChanceToIncrease>
      <mChanceToDecrease>0.45</mChanceToDecrease>
      <mChanceForAdditionalIncrease>0.15</mChanceForAdditionalIncrease>
      <mFlipHChance>0.4</mFlipHChance>
      <mFlipVChance>0.10</mFlipVChance>
      <mMaxFlickerFrame>8</mMaxFlickerFrame>
      <mFlickerTimeScale>1.5</mFlickerTimeScale>
      <mInvert>false</mInvert>
    </mFlickerData>

  </THGlitchVisualData>


  <!-- More subtle corruption than the one below it.-->
  <THGlitchVisualData mName="NPCSubtleCorruptionGlitch">
    <mTechnique>GlitchTechnique</mTechnique>

    <mRandomizeUVData>
      <mAnimateRandomUV>true</mAnimateRandomUV>
      <mGlobalTileOffset>
        <X>0</X>
        <Y>0</Y>
      </mGlobalTileOffset>
      <mMinRestDuration>30</mMinRestDuration>
      <mMaxRestDuration>60</mMaxRestDuration>
      <mMinRandomUVDuration>1</mMinRandomUVDuration>
      <mMaxRandomUVDuration>120</mMaxRandomUVDuration>
      <mChanceToRest>0.01</mChanceToRest>

      <!-- Starting randomization -->
      <mBaseRandomizeGlobalOffsetChance>0.0</mBaseRandomizeGlobalOffsetChance>
      <mBaseRandomizeGlobalOffsetRange>0</mBaseRandomizeGlobalOffsetRange>
      <mBaseMinTileOffset>0</mBaseMinTileOffset>
      <mBaseMaxTileOffset>1</mBaseMaxTileOffset>
      <mBasePerTileRandomizeChance>0.1</mBasePerTileRandomizeChance>
      <mBaseChanceToRandomizeDirectionOfOffset>0.1</mBaseChanceToRandomizeDirectionOfOffset>

      <!-- Randomization while animating-->
      <mDeltaRandomizeGlobalOffsetChance>0.00</mDeltaRandomizeGlobalOffsetChance>
      <mDeltaRandomizeGlobalOffsetRange>0</mDeltaRandomizeGlobalOffsetRange>
      <mDeltaMinTileOffset>0</mDeltaMinTileOffset>
      <mDeltaMaxTileOffset>1</mDeltaMaxTileOffset>
      <mDeltaPerTileRandomizeChance>0.75</mDeltaPerTileRandomizeChance>
			
			
      <mDeltaChanceToRandomizeOffsetAmount>0.25</mDeltaChanceToRandomizeOffsetAmount>
      <mDeltaChanceToRandomizeDirectionOfOffset>0.5</mDeltaChanceToRandomizeDirectionOfOffset>
			<mDeltaChanceToRandomizeSelectionRange>0.5</mDeltaChanceToRandomizeSelectionRange>

    </mRandomizeUVData>

  </THGlitchVisualData>



