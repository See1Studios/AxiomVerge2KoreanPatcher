  <!-- The postarctic station buildings. -->
  <THNPCData mName="DemolishableBuilding" mAllegiance="FRIEND" mHitPoints="30">

    <mThreatLevel>0.0</mThreatLevel>
    <mHackable>false</mHackable>

    <mHurtSound>StoneShatter</mHurtSound>

    <mDamageImpact>WoodChips</mDamageImpact>
  </THNPCData>

  <THNPCData mName="FallingSlab" mClass="THCrate" mAllegiance="NONE" mHitPoints="150">
    <mThreatLevel>0.0</mThreatLevel>
    <mPersistent>true</mPersistent>
    <mHackable>false</mHackable>
    
    <!-- Note that this is the hardness once it's fallen onto the ground.  When it's still suspsended, it has hardness 2-->
    <mHardness>4</mHardness>

    <mHurtSound>StoneCrack</mHurtSound>
    <mAdditionalSound mName="Death" mFileName="StoneShatter" mMaxInstances ="2" />
    <mAdditionalSound mName="Land" mFileName="Thud" />

    <mDamageImpact>WoodChips</mDamageImpact>
    <mDeathShatter>CollapsingSlabSpriteShatter</mDeathShatter>

    <mHealthDropChance>0.0</mHealthDropChance>

    <!-- Melee weapon, if it exists, causes damage while we're falling-->
    <mMeleeWeapon mName="FallingSlabMelee">

      <THDamageType>PHYSICAL</THDamageType>
      <mDamage>200</mDamage>
      <mHardness>2</mHardness>
    </mMeleeWeapon>

  </THNPCData>

  <THNPCData mName="FallingSlabCrumbling" mClass="THCrate" mAllegiance="NONE" mHitPoints="150">
    <mThreatLevel>0.0</mThreatLevel>
    <mHackable>false</mHackable>
    <mHardness>3</mHardness>

    <mHurtSound>StoneCrack</mHurtSound>
    <mAdditionalSound mName="Death" mFileName="StoneShatter" mMaxInstances ="2" />
    <mAdditionalSound mName="Land" mFileName="Thud" />

    <mDeathShatter>CollapsingSlabSpriteShatter</mDeathShatter>

    <mHealthDropChance>0.0</mHealthDropChance>

  </THNPCData>

