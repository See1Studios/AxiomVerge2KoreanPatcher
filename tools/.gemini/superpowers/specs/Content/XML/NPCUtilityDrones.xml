<?xml version="1.0" encoding="utf-8"?>
<THNPCSettings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- ######################################################################## -->
  <!-- AIR PURIFIER DRONE -->
  <!-- ######################################################################## -->
  <THNPCData mName="AirPurifierDrone" mClass="THAirPurifierDrone" mAllegiance="FOE" mHitPoints="70" mHackPoints="20">
    <mSpriteSheet>AirPurifierDrone.xml</mSpriteSheet>
    <mHurtSound>RobotHurt</mHurtSound>
    <mDeathShatter>MediumSpriteShatter</mDeathShatter>
    <mDeathExplosion>StaticDeathSpriteExplosion</mDeathExplosion>
    <mDeathDistortion>StaticDeathSpriteDistortion</mDeathDistortion>
    <mHealthDropChance>0.2</mHealthDropChance>
    <mMeleeWeapon mName="AirPurifierDroneMelee">
      <THDamageType>PHYSICAL</THDamageType>
      <mDamage>10</mDamage>
    </mMeleeWeapon>

    <THNPCHackInfo mType="SLOW" mHackLevel="1"/>
    <THNPCHackInfo mType="PLATFORM" mHackLevel="1"/>
  </THNPCData>

  <!-- ######################################################################## -->
  <!-- DISPENSER DRONE -->
  <!-- ######################################################################## -->
  <THNPCData mName="DispenserDrone" mClass="THDispenserDrone"  mAllegiance="ALL" mHitPoints="10000">
    <mSpriteSheet>DispenserDrone.xml</mSpriteSheet>
    
    <!-- Mark not a target-->
    <mThreatLevel>0.0</mThreatLevel>
    <mPulseRate>1.0</mPulseRate>

    <mAdditionalSound mName="Open" mFileName="DoorIrisOpen" />
    <mAdditionalSound mName="Close" mFileName="DoorIrisClose" />

    <THNPCHackInfo mType="HASTE" mHackLevel="1"/>
    <THNPCHackInfo mType="NEXT" mHackLevel="1"/>
  </THNPCData>
  
  
  <!-- ######################################################################## -->
  <!-- HYDRO DRONE -->
  <!-- ######################################################################## -->
  <THNPCData mName="HydroDrone" mClass="THHydroDrone"  mAllegiance="FOE" mHitPoints="125">
    <mHackable>true</mHackable>
    <mHackLevel>1</mHackLevel>
    <mSpriteSheet>HydroDrone.xml</mSpriteSheet>

    <mHurtSound>DroneHurt</mHurtSound>
    <mDeathShatter>SmallSpriteShatter</mDeathShatter>
    <mDeathExplosion>StaticDeathSpriteExplosion</mDeathExplosion>
    <mDeathDistortion>StaticDeathSpriteDistortion</mDeathDistortion>

    <THNPCHackInfo mType="RELEASE" mHackLevel="1"/>


    <mPulseColor>
      <X>23</X>
      <Y>255</Y>
      <Z>224</Z>
      <W>255</W>
    </mPulseColor>

  </THNPCData>

  <!-- ######################################################################## -->
  <!-- HYDROTHERMAL DRONE -->
  <!-- ######################################################################## -->
  <THNPCData mName="HydroThermalDrone" mClass="THHydroThermalDrone"  mAllegiance="FOE" mHitPoints="125">
    <mHackable>true</mHackable>
    <mHackLevel>1</mHackLevel>
    <mSpriteSheet>HydroThermalDrone.xml</mSpriteSheet>

    <mHurtSound>DroneHurt</mHurtSound>
    <mDeathShatter>SmallSpriteShatter</mDeathShatter>
    <mDeathExplosion>StaticDeathSpriteExplosion</mDeathExplosion>
    <mDeathDistortion>StaticDeathSpriteDistortion</mDeathDistortion>

    <THNPCHackInfo mType="RELEASE" mHackLevel="1"/>
    
    <mMeleeWeapon mName="HydroThermalDroneDroneMelee">
      <THDamageType>PHYSICAL</THDamageType>
      <mDamage>20</mDamage>
    </mMeleeWeapon>

    <mPulseColor>
      <X>23</X>
      <Y>255</Y>
      <Z>224</Z>
      <W>255</W>
    </mPulseColor>

  </THNPCData>

  <!-- ######################################################################## -->
  <!-- PLANTER DRONE -->
  <!-- ######################################################################## -->
  <THNPCData mName="PlanterDrone" mClass="THPlanterDrone" mAllegiance="FOE" mHitPoints="80" mHackPoints="90">
    <mSpriteSheet>PlanterDrone.xml</mSpriteSheet>

    <mHurtSound>DroneHurt</mHurtSound>
    <mDeathShatter>SmallSpriteShatter</mDeathShatter>
    <mDeathExplosion>StaticDeathSpriteExplosion</mDeathExplosion>
    <mDeathDistortion>StaticDeathSpriteDistortion</mDeathDistortion>

    <mAdditionalSound mName="EnterAggro" mFileName="DroneRoar" />

    <THNPCHackInfo mType="HASTE" mHackLevel="1"/>
    <THNPCHackInfo mType="SLOW" mHackLevel="1"/>
    
    <mMeleeWeapon  mName="PlanterDroneMelee">

      <THDamageType>PHYSICAL</THDamageType>
      <mDamage>80</mDamage>
      <mCoolDown>60</mCoolDown>
    </mMeleeWeapon>
  </THNPCData>

  <!-- ######################################################################## -->
  <!-- PLATFORM DRONE -->
  <!-- ######################################################################## -->
  <THNPCData mName="PlatformDrone" mClass="THPlatformDrone"  mAllegiance="ALL" mHitPoints="10000">
    <mHackable>true</mHackable>
    <mSpriteSheet>PlatformDrone.xml</mSpriteSheet>
    <mHurtSound>SpitbugHurt</mHurtSound>
    <mDeathShatter>SmallSpriteShatter</mDeathShatter>
    <mDeathExplosion>StaticDeathSpriteExplosion</mDeathExplosion>
    <mDeathDistortion>StaticDeathSpriteDistortion</mDeathDistortion>
    <mMountable>true</mMountable>

    <!-- Mark not a target-->
    <mThreatLevel>0.0</mThreatLevel>

    <THNPCHackInfo mType="ACTIVATE" mHackLevel="1"/>


    <mPulseColor>
      <X>23</X>
      <Y>255</Y>
      <Z>224</Z>
      <W>255</W>
    </mPulseColor>

  </THNPCData>

  <!-- ######################################################################## -->
  <!-- POLLINATOR DRONE -->
  <!-- ######################################################################## -->
  <THNPCData mName="PollinatorDrone" mClass="THPollinatorDrone"  mAllegiance="ALL" mHitPoints="25">
    <mHackable>true</mHackable>
    <mHackLevel>1</mHackLevel>
    <mSpriteSheet>PollinatorDrone.xml</mSpriteSheet>
    <mAdditionalSound mName="Dive" mFileName="DroneSting" />

    <mHurtSound>DroneHurt</mHurtSound>
    <mDeathShatter>SmallSpriteShatter</mDeathShatter>
    <mDeathExplosion>StaticDeathSpriteExplosion</mDeathExplosion>
    <mDeathDistortion>StaticDeathSpriteDistortion</mDeathDistortion>
   
    <THNPCHackInfo mType="SWARM" mHackLevel="1"/>


    <mPulseColor>
      <X>23</X>
      <Y>255</Y>
      <Z>224</Z>
      <W>255</W>
    </mPulseColor>

    <mMeleeWeapon mName="PollinatorDroneMelee">

      <THDamageType>PHYSICAL</THDamageType>
      <mDamage>3</mDamage>
      <mMaxSkewer>2</mMaxSkewer>
      <mDamagePeriod>8</mDamagePeriod>
      <mDamageStunFrames>4</mDamageStunFrames>
      <mInvincibilityDurationScale>0.25</mInvincibilityDurationScale>
    </mMeleeWeapon>

  </THNPCData>

  <!-- ######################################################################## -->
  <!-- POLLINATOR SWARM -->
  <!-- ######################################################################## -->
  <THNPCData mName="PollinatorSwarm" mClass="THPollinatorSwarm"  mAllegiance="FRIEND" mHitPoints="1000">
    <mHackable>false</mHackable>
    <!-- Mark not a target-->
    <mThreatLevel>0.0</mThreatLevel>
    <mSpriteSheet>PollinatorDrone.xml</mSpriteSheet>
    <mAdditionalSound mName="Dive" mFileName="DroneSting" />
  </THNPCData>

  <!-- ######################################################################## -->
  <!-- POWERCELL -->
  <!-- ######################################################################## -->
  <THNPCData mName="PowerCell" mClass="THPowerCell"  mAllegiance="ALL" mHitPoints="125">
    <mPersistent>true</mPersistent>
    <mHackable>true</mHackable>
    <mHackLevel>1</mHackLevel>
    <mSpriteSheet>PowerCell.xml</mSpriteSheet>
    <!-- Mark not a target-->
    <mThreatLevel>0.0</mThreatLevel>
    <mHurtSound>DroneHurt</mHurtSound>
    <mAdditionalSound mName="Fall" mFileName="Fall" />

    <mDeathShatter>SmallSpriteShatter</mDeathShatter>
    <mDeathExplosion>StaticDeathSpriteExplosion</mDeathExplosion>
    <mDeathDistortion>StaticDeathSpriteDistortion</mDeathDistortion>

    <THNPCHackInfo mType="DETONATE" mHackLevel="1" mCostOverride="5"/>
    <THNPCHackInfo mType="DROPHEALTH" mHackLevel="1" mCostOverride="0"/>
    <THNPCHackInfo mType="VOLATILE" mHackLevel="1" />
    <mPulseColor>
      <X>255</X>
      <Y>0</Y>
      <Z>0</Z>
      <W>255</W>
    </mPulseColor>
<!--
    <mPulseColor>
      <X>23</X>
      <Y>255</Y>
      <Z>224</Z>
      <W>255</W>
    </mPulseColor>-->

  </THNPCData>

  <!-- ######################################################################## -->
  <!-- SEALER DRONE -->
  <!-- ######################################################################## -->
  <THNPCData mName="SealerDrone" mClass="THSealerDrone" mAllegiance="FOE" mHitPoints="80" mHackPoints="90">
    <mSpriteSheet>SealerDrone.xml</mSpriteSheet>

    <mHurtSound>DroneHurt</mHurtSound>
    <mDeathShatter>SmallSpriteShatter</mDeathShatter>
    <mDeathExplosion>StaticDeathSpriteExplosion</mDeathExplosion>
    <mDeathDistortion>StaticDeathSpriteDistortion</mDeathDistortion>

    <THNPCHackInfo mType="SLOW" mHackLevel="1"/>
    <THNPCHackInfo mType="ALLEGIANCE" mHackLevel="1"/>    
    
    <mAdditionalSound mName="Steam" mFileName="Steam" />


  </THNPCData>


  <!-- ######################################################################## -->
  <!-- SOLAR DRONE -->
  <!-- ######################################################################## -->
  <THNPCData mName="SolarDrone" mClass="THSolarDrone" mAllegiance="FOE" mHitPoints="140" mHackPoints="20">
    <mSpriteSheet>SolarDrone.xml</mSpriteSheet>
    <mHurtSound>RobotHurt</mHurtSound>
    <mDeathShatter>MediumSpriteShatter</mDeathShatter>
    <mDeathExplosion>StaticDeathSpriteExplosion</mDeathExplosion>
    <mDeathDistortion>StaticDeathSpriteDistortion</mDeathDistortion>
    <mHealthDropChance>0.2</mHealthDropChance>
    <mMeleeWeapon mName="SolarDroneDroneMelee">
      <THDamageType>PHYSICAL</THDamageType>
      <mDamage>60</mDamage>
    </mMeleeWeapon>

    <mAdditionalSound mName="ElectricBurst" mFileName="ElectricBurst" />
    <mAdditionalSound mName="ElectricChargeup" mFileName="ElectricChargeup" />

    <THNPCHackInfo mType="SLOW" mHackLevel="1"/>
    <THNPCHackInfo mType="ALLEGIANCE" mHackLevel="3"/>
    <THNPCHackInfo mType="RELEASE" mHackLevel="1"/>

  </THNPCData>

