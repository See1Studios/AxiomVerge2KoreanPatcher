<?xml version="1.0" encoding="utf-8"?>
<THSecretWorldSettings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- The idea is that these are an item pool from which the secret worlds can draw. -->
  <!-- The strong and weak sets are to gate more powerful items for later.-->
  <!--
	Modified to have one secret area per area.
  Area 1:	
			Medium
  Area 2:
			Easy
  Area 3:
      Easy
  Area 4:  
      Easy
  Area 5: 
      Medium
  Area 6:
      Medium
  Area 7:
      Hard
  Area 8:
      Hard
  Area 9: 
      Hard
      
  Total:  9 Secret areas; 3 easy, 3 medium, 3 hard
      -->
	<!-- #################################################################### -->
  <!-- OUTSIDE SECRET WORLDS -->
  <!-- #################################################################### -->
  <THSecretWorldData>
    <mName>OutsideSecretWorld0</mName>
    <mSourceWorld>Outside</mSourceWorld>
    <mDifficulty>Easy</mDifficulty>
    <mTemplatePool>
			<mTemplate>TemplateA</mTemplate>
      <mTemplate>TemplateB</mTemplate>
      <mTemplate>TemplateC</mTemplate>
      <mTemplate>TemplateD</mTemplate>
			<mTemplate>TemplateE</mTemplate>
      <mTemplate>TemplateF</mTemplate><!-- visual only -->
    </mTemplatePool>
    <mTemplateVariation>0.75</mTemplateVariation>
    <mTemplateVisualVariation>0.5</mTemplateVisualVariation>
		
		<!-- These get added onto the base tile set name to create variant-->
		<TileSetVariantName>1</TileSetVariantName>
		<TileSetVariantName>2</TileSetVariantName>
		<TileSetVariantName>3</TileSetVariantName>
		<TileSetVariantName>4</TileSetVariantName>
		<TileSetVariantName>5</TileSetVariantName>
    
    <mMinRows>3</mMinRows>
    <mMaxRows>4</mMaxRows>
    <mMinRowLength>3</mMinRowLength>
    <mMaxRowLength>6</mMaxRowLength>
    <mMinRowHeight>2</mMinRowHeight>
    <mMaxRowHeight>3</mMaxRowHeight>    
    <mMinCorridorLength>1</mMinCorridorLength>
    <mMaxCorridorLength>3</mMaxCorridorLength>    
  
    <mMinAdditionalRooms>3</mMinAdditionalRooms>
    <mMaxAdditionalRooms>4</mMaxAdditionalRooms>    
    <mConnectAdjacentRoomsChance>75</mConnectAdjacentRoomsChance>
  </THSecretWorldData>
	

  <!-- #################################################################### -->
  <!-- ITEM POOLS -->
  <!-- #################################################################### -->
  <mDifficulty mName ="Easy">
		<mNumWorlds>1</mNumWorlds>
    <mItemPool mName="PrimaryItem">
      <mItem>RangeNodeRandom1</mItem>      
      <mItem>SizeNodeRandom1</mItem>
    </mItemPool>

    <mItemPool mName="SecondaryItem">
      <mItem>HealthNodeFragmentRandom1</mItem>
      <mItem>HealthNodeFragmentRandom2</mItem>
    </mItemPool>
  </mDifficulty>

  <mDifficulty mName ="Medium">
		<mNumWorlds>0</mNumWorlds>
    <mItemPool mName="PrimaryItem">      
      <mItem>RangeNodeRandom2</mItem>
      <mItem>SizeNodeRandom2</mItem>
    </mItemPool>

    <mItemPool mName="SecondaryItem">
      <mItem>HealthNodeFragmentRandom3</mItem>
      <mItem>HealthNodeFragmentRandom4</mItem>
    </mItemPool>
  </mDifficulty>

	<!-- THe idea here is that there is only one "Hard" world generated per playthrough, the players will need
	To re-play to see all the hidden weapons.-->
  <mDifficulty mName ="Hard">
		<mNumWorlds>0</mNumWorlds>
    <mItemPool mName="PrimaryItem">
      <mItem>HeatSeeker</mItem>
			<mItem>WebSlicer</mItem>
			<mItem>FatBeam</mItem>      
    </mItemPool>

    <mItemPool mName="SecondaryItem">
      <mItem>HealthNodeFragmentRandom5</mItem>
    </mItemPool>
  </mDifficulty>
  
</THSecretWorldSettings>