<?xml version="1.0" encoding="utf-8"?>
<THExplosionSettings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- ///////////////////////////// SPRITE EXPLOSIONS //////////////////////////////-->

  <!-- ######################################################################## -->
  <!-- EMOTES -->
  <!-- ######################################################################## -->
  <THSpriteExplosion mName="Exclamation">
    <mAnimationName>Exclamation</mAnimationName>
    <mMaxCount>32</mMaxCount>
    
  </THSpriteExplosion>

  <!-- ######################################################################## -->
  <!-- MISC -->
  <!-- ######################################################################## -->
  
  <!-- Item acquisition -->
  <THSpriteExplosion mName="AcquireItem">
    <mAnimationName>AcquireItem</mAnimationName>
    <mMaxCount>1</mMaxCount>
    <mTint>
      <X>1.0</X>
      <Y>1.0</Y>
      <Z>1.0</Z>
      <W>1.0</W>
    </mTint>
    <mStartScale>
      <X>1.0</X>
      <Y>1.0</Y>
    </mStartScale>
    <mEndScale>
      <X>1.0</X>
      <Y>1.0</Y>
    </mEndScale>
    <mSoundName>Powersurge</mSoundName>
  </THSpriteExplosion>

  <THSpriteExplosion mName="AcquireItemDistortion">
    <mAnimationName>DistortionRound64x64</mAnimationName>
    <mMaxCount>1</mMaxCount>
    <mFadeInDuration>0.5</mFadeInDuration>
    <mFadeOutDuration>0.5</mFadeOutDuration>
    <mStartScale>
      <X>1.0</X>
      <Y>1.0</Y>
    </mStartScale>
    <mEndScale>
      <X>2</X>
      <Y>2</Y>
    </mEndScale>
    <mDistortionScale>0.35</mDistortionScale>
    <mTimeStretch>60</mTimeStretch>
    <mRenderLayer>Distortion</mRenderLayer>
  </THSpriteExplosion>

