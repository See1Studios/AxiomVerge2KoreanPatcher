<?xml version="1.0" encoding="utf-8"?>
<THSurfaceEffectSettings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <THSurfaceEffectData mName="IndraDefault">
    <mViscosity>1.0</mViscosity>
    <mFootstepSound>FootstepDirt</mFootstepSound>
    <mLandingSound>FootstepDirt</mLandingSound>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="TraceDefault">
    <mViscosity>1.0</mViscosity>
    <mFootstepSound>TraceFootStep</mFootstepSound>
    <mLandingSound>TraceLand</mLandingSound>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="DroneDefault">
    <mViscosity>1.0</mViscosity>
    <mFootstepSound>DroneFootstepLight</mFootstepSound>
    <mLandingSound>DroneFootstepLight</mLandingSound>
  </THSurfaceEffectData>


  <THSurfaceEffectData mName="FieldDefault">
    <mViscosity>1.0</mViscosity>
  </THSurfaceEffectData>


  <THSurfaceEffectData mName="Bushes">
    <mViscosity>1.5</mViscosity>
    <mRustleSound>BushRustle</mRustleSound>
    <mRustlePeriod>20.0</mRustlePeriod>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="CabezonGoo">
    <mViscosity>2.0</mViscosity>
    <mRustleSound>SquishA</mRustleSound>
    <mRustlePeriod>20.0</mRustlePeriod>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="ElectrifiedFloor">
    <mViscosity>1.25</mViscosity>
    <mDamageSound>ElectricBurstShort</mDamageSound>
    <!-- Set the damge period to 0 to have it injure the player immediately and go into wound state-->
    <mDamagePeriod>0.0</mDamagePeriod>
    <mDamage>50</mDamage>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="Fire">
    <mViscosity>1.25</mViscosity>
    <mDamageSound>FireballShort</mDamageSound>
    <!-- Set the damge period to 0 to have it injure the player immediately and go into wound state-->
    <mDamagePeriod>0.0</mDamagePeriod>
    <mDamage>24</mDamage>
  </THSurfaceEffectData>

  <!-- When the surface is made of packed snow you can stand on top of. -->
  <THSurfaceEffectData mName="PackedSnow">
    <mViscosity>1.0</mViscosity>
    <mFootstepSound>PackedSnowCrunch</mFootstepSound>
    <mLandingSound>PackedSnowCrunch</mLandingSound>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="MediumSnow">
    <mViscosity>1.25</mViscosity>
    <mJumpingExplosion>JumpingSnowPoof</mJumpingExplosion>
    <mLandingExplosion>LandingSnowPoof</mLandingExplosion>
    <mRunningExplosion>RunningSnowPoof</mRunningExplosion>
    <mAttachRunningExplosion>true</mAttachRunningExplosion>
    <mFootstepSound>SnowCrunch</mFootstepSound>
    <mLandingSound>SnowCrunch</mLandingSound>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="MediumSnowNoJumpPoof">
    <mViscosity>1.25</mViscosity>
    <mLandingExplosion>LandingSnowPoof</mLandingExplosion>
    <mRunningExplosion>RunningSnowPoof</mRunningExplosion>
    <mAttachRunningExplosion>true</mAttachRunningExplosion>
    <mFootstepSound>SnowCrunch</mFootstepSound>
    <mLandingSound>SnowCrunch</mLandingSound>
  </THSurfaceEffectData>

  <!-- Snow resting on the top of a surface, does not impede movement-->
  <THSurfaceEffectData mName="LightSnowField">
    <mViscosity>1.0</mViscosity>
    <mJumpingExplosion>JumpingSnowPoof</mJumpingExplosion>
    <mLandingExplosion>LandingSnowPoof</mLandingExplosion>
    <mRunningExplosion>RunningSnowPoof</mRunningExplosion>
    <mAttachRunningExplosion>true</mAttachRunningExplosion>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="Sand">
    <mViscosity>1.0</mViscosity>
    <mJumpingExplosion>JumpingSandPoof</mJumpingExplosion>
    <mLandingExplosion>LandingSandPoof</mLandingExplosion>
    <mRunningExplosion>RunningSandPoof</mRunningExplosion>
    <mAttachRunningExplosion>true</mAttachRunningExplosion>
    <mFootstepSound>FootstepSand</mFootstepSound>
    <mLandingSound>FootstepSand</mLandingSound>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="Silent">
    <mViscosity>1.0</mViscosity>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="UdugBrambles">
    <mViscosity>1.25</mViscosity>
    <mDamageSound>HealthDrain</mDamageSound>
    <!-- Set the damge period to 0 to have it injure the player immediately and go into wound state-->
    <mDamagePeriod>0.0</mDamagePeriod>
    <mDamage>8</mDamage>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="UnderwaterDirt">
    <mViscosity>1.0</mViscosity>
    <mFootstepSound>FootstepUnderwater</mFootstepSound>
    <mLandingSound>FootstepUnderwater</mLandingSound>
    <mFootstepParticleSpawner>MudPlume</mFootstepParticleSpawner>
    <mClipToField>true</mClipToField>
    <mNumFootstepParticles>30</mNumFootstepParticles>
    <mNumLandingParticles>60</mNumLandingParticles>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="UnderwaterStone">
    <mViscosity>1.0</mViscosity>
    <mFootstepSound>FootstepUnderwater</mFootstepSound>
    <mLandingSound>FootstepUnderwater</mLandingSound>
  </THSurfaceEffectData>




  <THSurfaceEffectData mName="CiliaPurple">
    <mViscosity>1.5</mViscosity>
    <mRustleSound>SquishA</mRustleSound>
    <mRustlePeriod>20.0</mRustlePeriod>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="TentacleGrass">
    <mViscosity>1.25</mViscosity>
    <mDamageSound>TentacleGrassDrain</mDamageSound>
    <mDamagePeriod>20.0</mDamagePeriod>
    <mDamage>24</mDamage>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="Lava">
    <mViscosity>2.0</mViscosity>
    <mDamageSound>HealthDrain</mDamageSound>
    <mSplashSound>Bubbles</mSplashSound>
    <mDamagePeriod>5.0</mDamagePeriod>
    <mDamage>12</mDamage>
		<mCanDrown>true</mCanDrown>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="Acid">
    <mViscosity>1.5</mViscosity>
    <mDamageSound>HealthDrain</mDamageSound>
    <mSplashSound>Splash</mSplashSound>
    <mDamagePeriod>5.0</mDamagePeriod>
    <mDamage>8</mDamage>
    <mSplashExplosion>BubblingFluidSplash</mSplashExplosion>
		<mCanDrown>true</mCanDrown>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="Water02">
    <mViscosity>1.0</mViscosity>
    <mTimeScale>0.75</mTimeScale>
    <mSplashSound>Splash</mSplashSound>
    <mSplashExplosion>WaterSplash02</mSplashExplosion>
		<mCanDrown>true</mCanDrown>
  </THSurfaceEffectData>

  <THSurfaceEffectData mName="DestructOnTouch">
    <mViscosity>1.0</mViscosity>
    <mDestructsOnTouch>true</mDestructsOnTouch>
  </THSurfaceEffectData>
  
</THSurfaceEffectSettings>
