<Window x:Class="AV2Patcher.Modern.TranslationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Translation Editor" Height="650" Width="950"
        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
        WindowStartupLocation="CenterOwner">
    
    <Window.Resources>
        <!-- 기본 TextBlock 스타일: 글자 대비 완화 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 필터/검색 영역 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <ComboBox x:Name="cbCsvFiles" Width="150" Height="26" FontSize="11" Margin="0,0,6,0"
                          SelectionChanged="OnCsvFileSelectionChanged"
                          ui:ControlHelper.PlaceholderText="Select CSV file..."/>

                <Button x:Name="btnOpenCsv" Content="에디터로 열기" Height="26" FontSize="11" Margin="0,0,6,0" IsEnabled="False"
                        Click="OnOpenCsvClicked" ToolTip="선택된 CSV 파일을 시스템 기본 에디터로 엽니다."/>

                <Button x:Name="btnOpenCsvFolder" Content="위치 열기" Height="26" FontSize="11" Margin="0,0,6,0" IsEnabled="False"
                        Click="OnOpenCsvFolderClicked" ToolTip="번역 CSV 파일이 위치한 폴더를 엽니다."/>

                <Button x:Name="btnRefreshCsv" Content="새로 고침" Height="26" FontSize="11" Margin="0,0,6,0" IsEnabled="False"
                        Click="OnRefreshCsvClicked" ToolTip="선택된 CSV 파일을 디스크로부터 다시 읽어옵니다."/>
            </StackPanel>

            <TextBox Grid.Column="1" x:Name="txtSearch" Height="26" FontSize="11" Margin="0,0,6,0"
                     TextChanged="OnSearchTextChanged"
                     ui:ControlHelper.PlaceholderText="Search Key, Original, or Translation..."/>

            <CheckBox Grid.Column="2" x:Name="chkUntranslatedOnly" Content="미번역만 보기" 
                      FontSize="11" VerticalAlignment="Center"
                      Checked="OnFilterOptionChanged" Unchecked="OnFilterOptionChanged"/>
        </Grid>

        <!-- 중앙 표 영역 -->
        <DataGrid Grid.Row="1" x:Name="dgTranslations" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False" 
                  SelectionMode="Single" HeadersVisibility="Column"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1" GridLinesVisibility="Horizontal" RowHeight="NaN"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="NoWrap"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="FontSize" Value="10.5"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="4,2"/>
                            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Original (English)" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding English, Mode=OneWay}" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0" TextWrapping="Wrap"
                                     FontSize="10.5" VerticalAlignment="Center" Margin="2,2" Padding="2"
                                     Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Original (Japanese)" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Original, Mode=OneWay}" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0" TextWrapping="Wrap"
                                     FontSize="10.5" VerticalAlignment="Center" Margin="2,2" Padding="2"
                                     Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Translation (Korean)" Binding="{Binding Translation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="FontSize" Value="10.5"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="4,4"/>
                            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="AcceptsReturn" Value="True"/>
                            <Setter Property="FontSize" Value="10.5"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="2"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="구글 번역" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="일→한" FontSize="10" Height="22" Padding="4,0" Margin="2,0"
                                        VerticalAlignment="Center" Click="OnRowTranslateJpClicked"
                                        ToolTip="일본어 원문을 한국어로 자동 번역합니다."/>
                                <Button Content="영→한" FontSize="10" Height="22" Padding="4,0" Margin="2,0"
                                        VerticalAlignment="Center" Click="OnRowTranslateEnClicked"
                                        ToolTip="영어 원문을 한국어로 자동 번역합니다."/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 하단 상태 및 저장 영역 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="tbEditorStatus" Text="Ready. Select a CSV file to begin editing." FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>

            <Button Grid.Column="1" x:Name="btnSaveTranslations" Content="Save Translations" 
                    Style="{StaticResource AccentButtonStyle}" Height="28" Width="150"
                    IsEnabled="False" Click="OnSaveTranslationsClicked"/>
        </Grid>
    </Grid>
</Window>
